<Window x:Class="Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Launcher Native" Height="780" Width="1180" MinHeight="660" MinWidth="1020" WindowState="Maximized"
        Icon="Assets/LauncherIcon.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#0C0F17">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="0" Background="#101829" BorderBrush="#2A3652" BorderThickness="0,0,0,1">
            <Border.Resources>
                <Style TargetType="Menu">
                    <Setter Property="Background" Value="#101829" />
                    <Setter Property="Foreground" Value="#EAF1FF" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="10,6" />
                </Style>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#EAF1FF" />
                    <Setter Property="Background" Value="#101829" />
                    <Setter Property="Padding" Value="12,6" />
                    <Setter Property="Margin" Value="1" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#1B2A47" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter Property="Background" Value="#1B2A47" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Resources>
            <Menu BorderThickness="0">
                <MenuItem Header="File">
                    <MenuItem Header="Exit" Click="ExitMenuItem_OnClick" />
                </MenuItem>
                <MenuItem Header="Help">
                    <MenuItem Header="Check for Updates" Click="CheckForUpdatesMenuItem_OnClick" />
                    <MenuItem Header="About" Click="AboutMenuItem_OnClick" />
                </MenuItem>
            </Menu>
        </Border>

        <Border Grid.Row="1" Margin="16" Padding="14" CornerRadius="10" Background="#121A2A" BorderBrush="#2A3652" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Launcher Native Desktop" FontSize="22" FontWeight="SemiBold" Foreground="#DCE6FF" />
                    <TextBlock Margin="0,4,0,0" Text="Phase 1 bridge: run existing launcher.ps1 with Start/Close modes while native migration is underway." Foreground="#8FA8D8" TextWrapping="Wrap" />
                    <TextBlock x:Name="StatusText" Margin="0,8,0,0" Text="Ready" Foreground="#8CE0A1" FontWeight="SemiBold" />
                    <TextBlock x:Name="CurrentUserTextBlock" Margin="0,4,0,0" Foreground="#BFD2F7" Text="Signed in user" />
                </StackPanel>
                <CheckBox x:Name="DryRunCheckBox" Grid.Column="1" Margin="12,4,0,0" Content="Dry Run" IsChecked="False" Foreground="#DCE6FF" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="16,0,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="12" CornerRadius="10" Background="#121A2A" BorderBrush="#2A3652" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Launcher Config" Foreground="#DCE6FF" FontWeight="SemiBold" />
                    <DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="True">
                        <Button x:Name="BrowseConfigButton" Content="Browse" Width="90" Height="30" Margin="8,0,0,0" DockPanel.Dock="Right" Click="BrowseConfigButton_OnClick" />
                        <Button x:Name="ReloadConfigButton" Content="Reload" Width="90" Height="30" Margin="8,0,0,0" DockPanel.Dock="Right" Click="ReloadConfigButton_OnClick" />
                        <TextBox x:Name="ConfigPathTextBox" Height="30" VerticalContentAlignment="Center" Padding="8,0" Background="#0D1422" Foreground="#DCE6FF" BorderBrush="#2A3652" BorderThickness="1" />
                    </DockPanel>
                </Grid>
            </Border>

            <WrapPanel Grid.Row="1" Margin="0,10,0,0" ItemHeight="36">
                <Button x:Name="StartButton" Width="220" Height="36" Margin="0,0,8,8" Content="Run Start" Click="StartButton_OnClick" />
                <Button x:Name="CloseButton" Width="220" Height="36" Margin="0,0,8,8" Content="Run Close" Click="CloseButton_OnClick" />
                <Button x:Name="StartAndWaitButton" Width="220" Height="36" Margin="0,0,8,8" Content="Start + Wait For CLOSEAPPS" Click="StartAndWaitButton_OnClick" />
                <CheckBox x:Name="UseLearnedOrderThisRunCheckBox" Margin="0,8,12,8" Foreground="#DCE6FF" Content="Use Learned Order This Run" VerticalAlignment="Center" />
                <Button x:Name="StopButton" Width="220" Height="36" Margin="0,0,0,8" Content="STOP" FontWeight="Bold" IsEnabled="False" Click="StopButton_OnClick">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#C0392B" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Setter Property="BorderBrush" Value="#E74C3C" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#4A2126" />
                                    <Setter Property="Foreground" Value="#C79197" />
                                    <Setter Property="BorderBrush" Value="#6B2A31" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D9483A" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </WrapPanel>
        </Grid>

        <TabControl Grid.Row="3" Margin="16,0,16,16" Background="#121A2A" BorderBrush="#2A3652" BorderThickness="1">
            <TabItem Header="Run">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12" Background="#121A2A">
                <Grid Background="#121A2A">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Margin="0,0,8,0" Padding="10" CornerRadius="10" Background="#101829" BorderBrush="#2A3652" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Configured Steps (Editable Enabled State)" FontWeight="SemiBold" Foreground="#DCE6FF" />

                            <WrapPanel Grid.Row="1" Margin="0,8,0,8" ItemHeight="30">
                                <Button x:Name="DetectRunningButton" Content="Native Detect Running" Width="160" Height="30" Click="DetectRunningButton_OnClick" />
                                <Button x:Name="DetectCloseTargetsButton" Content="Native Detect Close Targets" Width="190" Height="30" Margin="8,0,0,0" Click="DetectCloseTargetsButton_OnClick" />
                                <Button x:Name="LearnOpenAppsButton" Content="Learn Open Apps" Width="140" Height="30" Margin="8,0,0,0" Click="LearnOpenAppsButton_OnClick" />
                                <Button x:Name="StartTeachSessionButton" Content="Start Teach Session" Width="160" Height="30" Margin="8,0,0,0" Click="StartTeachSessionButton_OnClick" />
                                <Button x:Name="StopTeachSessionButton" Content="Stop Teach Session" Width="160" Height="30" Margin="8,0,0,0" Click="StopTeachSessionButton_OnClick" IsEnabled="False" />
                                <Button x:Name="ApplyTeachSessionButton" Content="Apply Taught Flow" Width="150" Height="30" Margin="8,0,0,0" Click="ApplyTeachSessionButton_OnClick" IsEnabled="False" />
                            </WrapPanel>

                            <DataGrid x:Name="StepsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      Background="#0D1422" Foreground="#DCE6FF" BorderBrush="#2A3652" BorderThickness="1"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      SelectionMode="Single" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, Mode=TwoWay}" Width="80" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="100" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="220" />
                                    <DataGridTextColumn Header="Program" Binding="{Binding ProgramPath}" IsReadOnly="True" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Margin="8,0,0,0" Padding="10" CornerRadius="10" Background="#101829" BorderBrush="#2A3652" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Learned Recommended Order" FontWeight="SemiBold" Foreground="#DCE6FF" />
                            <TextBlock x:Name="RecommendedOrderStatusText" Grid.Row="1" Margin="0,6,0,0" Foreground="#8FA8D8" TextWrapping="Wrap" />
                            <ListBox x:Name="RecommendedOrderListBox" Grid.Row="2" Margin="0,8,0,12" Height="130" Background="#0D1422" Foreground="#DCE6FF" BorderBrush="#2A3652" BorderThickness="1" />
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Live Output" FontWeight="SemiBold" Foreground="#DCE6FF" />
                                <ListBox x:Name="LogListBox" Grid.Row="1" Margin="0,8,0,0" Background="#0D1422" Foreground="#BFD2F7" BorderBrush="#2A3652" BorderThickness="1" FontFamily="Consolas" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12" Background="#121A2A">
                <Grid Background="#121A2A">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="12" CornerRadius="10" Background="#101829" BorderBrush="#2A3652" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Global Launcher Settings" FontWeight="SemiBold" Foreground="#DCE6FF" />
                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox x:Name="CheckForUpdatesCheckBox" Content="Check For Updates" Foreground="#DCE6FF" Margin="0,0,18,8" />
                                <CheckBox x:Name="EnsureCapsLockCheckBox" Content="Ensure Caps Lock On" Foreground="#DCE6FF" Margin="0,0,18,8" />
                                <CheckBox x:Name="EnsureNumLockCheckBox" Content="Ensure Num Lock On" Foreground="#DCE6FF" Margin="0,0,18,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="0,10,0,0" Padding="12" CornerRadius="10" Background="#101829" BorderBrush="#2A3652" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Close Tracking" Foreground="#DCE6FF" />
                                <CheckBox x:Name="CloseOnlyTrackedCheckBox" Content="Close Only Tracked Apps" Foreground="#DCE6FF" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Default Close Method" Foreground="#DCE6FF" />
                                <ComboBox x:Name="DefaultCloseMethodComboBox" Margin="0,6,0,0" Height="28">
                                    <ComboBoxItem Content="both" />
                                    <ComboBoxItem Content="graceful" />
                                    <ComboBoxItem Content="process" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="Default Timeout (sec)" Foreground="#DCE6FF" />
                                <TextBox x:Name="DefaultCloseTimeoutTextBox" Margin="0,6,0,0" Height="28" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                <TextBlock Text="Default Force Close" Foreground="#DCE6FF" />
                                <CheckBox x:Name="DefaultCloseForceCheckBox" Content="Enabled" Foreground="#DCE6FF" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2" Margin="2,10,0,0" Text="Tip: You can toggle individual step enabled states in the Run tab and save all settings together." Foreground="#8FA8D8" />

                    <Border Grid.Row="3" Margin="0,10,0,0" Padding="12" CornerRadius="10" Background="#101829" BorderBrush="#2A3652" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Learning" Foreground="#DCE6FF" />
                                <CheckBox x:Name="LearningEnabledCheckBox" Content="Enable Learning" Foreground="#DCE6FF" Margin="0,6,0,0" />
                                <CheckBox x:Name="ShowRecommendedOrderCheckBox" Content="Show Recommended Order" Foreground="#DCE6FF" Margin="0,4,0,0" />
                                <CheckBox x:Name="AutoApplyRecommendedOrderCheckBox" Content="Auto Apply Recommended Order" Foreground="#DCE6FF" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Minimum Runs" Foreground="#DCE6FF" />
                                <TextBox x:Name="MinRunsBeforeSuggestionsTextBox" Margin="0,6,0,0" Height="28" Width="120" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Margin="10,0,0,0" Foreground="#8FA8D8" TextWrapping="Wrap"
                                       Text="When auto-apply is enabled, launch steps run in learned order once enough history exists." />
                            <Button x:Name="ResetLearningHistoryButton" Grid.Column="3" Width="190" Height="34" Margin="12,0,0,0"
                                    VerticalAlignment="Top" Content="Reset Learning History" Click="ResetLearningHistoryButton_OnClick" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="SaveSettingsButton" Width="180" Height="34" Content="Save Config Changes" Click="SaveSettingsButton_OnClick" />
                        <Button x:Name="ResetSettingsButton" Width="180" Height="34" Margin="8,0,0,0" Content="Reload Without Saving" Click="ResetSettingsButton_OnClick" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Program Builder">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12" Background="#121A2A">
                <Grid Background="#121A2A">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Add or Update Program Step" FontSize="18" FontWeight="SemiBold" Foreground="#DCE6FF" />

                    <Border Grid.Row="1" Margin="0,10,0,0" Padding="12" CornerRadius="10" Background="#101829" BorderBrush="#2A3652" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Step Name" Foreground="#DCE6FF" Margin="0,4,8,8" />
                                <TextBox x:Name="ProgramStepNameTextBox" Grid.Column="1" Height="28" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="1" Text="Program Path" Foreground="#DCE6FF" Margin="0,4,8,8" />
                                <TextBox x:Name="ProgramPathTextBox" Grid.Row="1" Grid.Column="1" Height="28" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="2" Text="Arguments" Foreground="#DCE6FF" Margin="0,4,8,8" />
                                <TextBox x:Name="ProgramArgumentsTextBox" Grid.Row="2" Grid.Column="1" Height="28" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="3" Text="Working Directory" Foreground="#DCE6FF" Margin="0,4,8,8" />
                                <TextBox x:Name="ProgramWorkingDirectoryTextBox" Grid.Row="3" Grid.Column="1" Height="28" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="4" Text="Main Window Title" Foreground="#DCE6FF" Margin="0,4,8,8" />
                                <TextBox x:Name="ProgramWindowTitleTextBox" Grid.Row="4" Grid.Column="1" Height="28" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="5" Text="Login Window Title" Foreground="#DCE6FF" Margin="0,4,8,8" />
                                <TextBox x:Name="ProgramLoginWindowTitleTextBox" Grid.Row="5" Grid.Column="1" Height="28" Margin="0,0,0,8" />

                                <Grid Grid.Row="6" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Timing (sec)" Foreground="#DCE6FF" Margin="0,4,8,0" />
                                    <TextBox x:Name="ProgramPostLaunchDelayTextBox" Grid.Column="1" Height="28" Margin="0,0,8,0" ToolTip="Post Launch" />
                                    <TextBox x:Name="ProgramWaitAfterStepTextBox" Grid.Column="2" Height="28" Margin="0,0,8,0" ToolTip="Wait After Step" />
                                    <TextBox x:Name="ProgramWaitForLoginCompleteTextBox" Grid.Column="3" Height="28" Margin="0,0,8,0" ToolTip="Wait For Login Complete" />
                                    <TextBlock Grid.Column="4" Text="Post Launch / Wait After / Login Wait" Foreground="#8FA8D8" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Column="1" Margin="14,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Program Search" Foreground="#DCE6FF" />
                                <Grid Grid.Row="1" Margin="0,6,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ProgramSearchQueryTextBox" Height="28" Margin="0,0,8,0" ToolTip="Type a program name to search" />
                                    <Button x:Name="SearchProgramsButton" Grid.Column="1" Height="28" Margin="0,0,8,0" Content="Search" Click="SearchProgramsButton_OnClick" />
                                    <Button x:Name="ApplyProgramSearchResultButton" Grid.Column="2" Height="28" Margin="0,0,8,0" Content="Use Selected" Click="ApplyProgramSearchResultButton_OnClick" />
                                    <Button x:Name="LearnProgramsIntoSearchButton" Grid.Column="3" Height="28" Content="Learn Open Apps" Click="LearnOpenAppsButton_OnClick" />
                                </Grid>
                                <ListBox x:Name="ProgramSearchResultsListBox" Grid.Row="2" Height="110" Background="#0D1422" Foreground="#DCE6FF" BorderBrush="#2A3652" BorderThickness="1" DisplayMemberPath="DisplayText" />

                                <TextBlock Grid.Row="3" Text="Login Sequence" Foreground="#DCE6FF" Margin="0,12,0,0" />
                                <TextBlock Grid.Row="4" Margin="0,4,0,8" Text="One key command per line. Optional delay format: keys|delayMs. For secrets use tokens like {{secret:MyPassword}}" Foreground="#8FA8D8" TextWrapping="Wrap" />
                                <TextBox x:Name="ProgramLoginKeysTextBox" Grid.Row="5" Height="120" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />

                                <StackPanel Grid.Row="6" Margin="0,12,0,0">
                                    <TextBlock Text="Secure Secret Vault" Foreground="#DCE6FF" />
                                    <Grid Margin="0,6,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="160" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ProgramSecretNameTextBox" Height="28" Margin="0,0,8,0" ToolTip="Secret Name" />
                                        <PasswordBox x:Name="ProgramSecretValuePasswordBox" Grid.Column="1" Height="28" Margin="0,0,8,0" ToolTip="Secret Value" />
                                        <Button x:Name="SaveProgramSecretButton" Grid.Column="2" Height="28" Margin="0,0,8,0" Content="Save Secret" Click="SaveProgramSecretButton_OnClick" />
                                        <Button x:Name="InsertSecretTokenButton" Grid.Column="3" Height="28" Content="Insert Token" Click="InsertSecretTokenButton_OnClick" />
                                    </Grid>

                                    <TextBlock Text="Manage Saved Secrets" Foreground="#DCE6FF" />
                                    <Grid Margin="0,6,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="RenameSecretNameTextBox" Height="28" Margin="0,0,8,0" ToolTip="New Secret Name" />
                                        <Button x:Name="RefreshSecretsButton" Grid.Column="1" Height="28" Margin="0,0,8,0" Content="Refresh" Click="RefreshSecretsButton_OnClick" />
                                        <Button x:Name="RenameSecretButton" Grid.Column="2" Height="28" Margin="0,0,8,0" Content="Rename" Click="RenameSecretButton_OnClick" />
                                        <Button x:Name="DeleteSecretButton" Grid.Column="3" Height="28" Content="Delete" Click="DeleteSecretButton_OnClick" />
                                    </Grid>
                                    <ListBox x:Name="SecretsListBox" Height="110" Background="#0D1422" Foreground="#DCE6FF" BorderBrush="#2A3652" BorderThickness="1" SelectionChanged="SecretsListBox_OnSelectionChanged" />

                                    <TextBlock Text="Productivity Notes / Additional Info" Foreground="#DCE6FF" />
                                    <TextBox x:Name="ProgramProductivityNotesTextBox" Margin="0,6,0,0" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" MinHeight="130" />
                                </StackPanel>

                                <WrapPanel Grid.Row="7" Margin="0,12,0,0">
                                    <Button x:Name="AddOrUpdateProgramStepButton" Width="200" Height="34" Content="Add / Update Program Step" Click="AddOrUpdateProgramStepButton_OnClick" />
                                    <Button x:Name="PopulateBuilderFromSelectedStepButton" Width="210" Height="34" Margin="8,0,0,0" Content="Load Selected Step Into Builder" Click="PopulateBuilderFromSelectedStepButton_OnClick" />
                                    <Button x:Name="ClearProgramBuilderButton" Width="150" Height="34" Margin="8,0,0,0" Content="Clear Form" Click="ClearProgramBuilderButton_OnClick" />
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
