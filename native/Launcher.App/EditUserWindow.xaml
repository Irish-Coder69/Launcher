<Window x:Class="Launcher.App.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit User"
        Height="590"
        Width="560"
        MinHeight="560"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0C0F17">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Edit User"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#DCE6FF" />

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Padding="12"
                CornerRadius="10"
                BorderBrush="#2A3652"
                BorderThickness="1"
                Background="#101829">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="User Name" Foreground="#DCE6FF" Margin="0,5,8,8" />
                <TextBox x:Name="UserNameTextBox" Grid.Column="1" Height="28" Margin="0,0,0,8" />

                <TextBlock Grid.Row="1" Text="Display Name" Foreground="#DCE6FF" Margin="0,5,8,8" />
                <TextBox x:Name="DisplayNameTextBox" Grid.Row="1" Grid.Column="1" Height="28" Margin="0,0,0,8" />

                <TextBlock Grid.Row="2" Text="Email" Foreground="#DCE6FF" Margin="0,5,8,8" />
                <TextBox x:Name="EmailTextBox" Grid.Row="2" Grid.Column="1" Height="28" Margin="0,0,0,8" />

                <TextBlock Grid.Row="3" Text="Department" Foreground="#DCE6FF" Margin="0,5,8,8" />
                <TextBox x:Name="DepartmentTextBox" Grid.Row="3" Grid.Column="1" Height="28" Margin="0,0,0,8" />

                <TextBlock Grid.Row="4" Text="Current Password" Foreground="#DCE6FF" Margin="0,5,8,8" />
                <PasswordBox x:Name="CurrentPasswordBox" Grid.Row="4" Grid.Column="1" Height="28" Margin="0,0,0,8" />

                <TextBlock Grid.Row="5" Text="New Password" Foreground="#DCE6FF" Margin="0,5,8,8" />
                <PasswordBox x:Name="NewPasswordBox" Grid.Row="5" Grid.Column="1" Height="28" Margin="0,0,0,8" />

                <TextBlock Grid.Row="6" Text="Confirm New Password" Foreground="#DCE6FF" Margin="0,5,8,8" />
                <PasswordBox x:Name="ConfirmNewPasswordBox" Grid.Row="6" Grid.Column="1" Height="28" Margin="0,0,0,8" />

                <TextBlock Grid.Row="7" Grid.Column="1" Foreground="#8FA8D8" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="Leave New Password blank if you only want to update the user name, display info, or notes." />

                <TextBlock Grid.Row="8" Text="Notes" Foreground="#DCE6FF" Margin="0,5,8,8" VerticalAlignment="Top" />
                <TextBox x:Name="NotesTextBox" Grid.Row="8" Grid.Column="1" AcceptsReturn="True" Height="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="CancelButton" Width="90" Height="34" Content="Cancel" Click="CancelButton_OnClick" DockPanel.Dock="Right" Margin="8,0,0,0" />
            <Button x:Name="SaveButton" Width="120" Height="34" Content="Save User" Click="SaveButton_OnClick" DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</Window>
