<Window x:Class="Launcher.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Login"
        Height="430"
        Width="540"
        MinHeight="400"
        MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0C0F17">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Launcher Login"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#DCE6FF" />
            <TextBlock x:Name="LoginStatusTextBlock"
                       Margin="0,8,0,0"
                       Foreground="#8FA8D8"
                       TextWrapping="Wrap"
                       Text="Select a user and sign in." />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Padding="12"
                CornerRadius="10"
                BorderBrush="#2A3652"
                BorderThickness="1"
                Background="#101829">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="User" Foreground="#DCE6FF" Margin="0,5,8,8" />
                <ComboBox x:Name="UserComboBox" Grid.Column="1" Height="28" DisplayMemberPath="DisplayName" SelectedValuePath="UserName" Margin="0,0,0,8" KeyDown="SubmitOnEnter_KeyDown" />

                <TextBlock Grid.Row="1" Text="Password" Foreground="#DCE6FF" Margin="0,5,8,8" />
                <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Height="28" Margin="0,0,0,8" KeyDown="SubmitOnEnter_KeyDown" />

                <TextBlock Grid.Row="2" Text="Issue Note" Foreground="#DCE6FF" Margin="0,5,8,8" VerticalAlignment="Top" />
                <TextBox x:Name="IssueNoteTextBox" Grid.Row="2" Grid.Column="1" AcceptsReturn="True" Height="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="CancelButton" Width="90" Height="34" Content="Exit" Click="CancelButton_OnClick" DockPanel.Dock="Right" Margin="8,0,0,0" IsCancel="True" />
            <Button x:Name="CreateUserButton" Width="110" Height="34" Content="Create User" Click="CreateUserButton_OnClick" DockPanel.Dock="Left" />
            <Button x:Name="EditUserButton" Width="110" Height="34" Content="Edit User" Click="EditUserButton_OnClick" DockPanel.Dock="Left" Margin="8,0,0,0" />
            <Button x:Name="LoginButton" Width="90" Height="34" Content="Login" Click="LoginButton_OnClick" DockPanel.Dock="Right" IsDefault="True" />
        </DockPanel>
    </Grid>
</Window>
